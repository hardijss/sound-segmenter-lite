{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AudioSplitter",
  "version": "1.0.0",
  "identifier": "com.hardijs.audiosplitter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AudioSplitter — 25 FPS 8n+1",
        "width": 1320,
        "height": 920,
        "minWidth": 1000,
        "minHeight": 680,
        "dragDropEnabled": false,
        "backgroundColor": "#090d16"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Music",
    "shortDescription": "25 FPS 8n+1 audio segment splitter",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
